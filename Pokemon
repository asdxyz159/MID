void CreateBoxPokemon_Ultimate(struct BoxPokemon *boxMon, u16 species, u8 level) {
u32 i;
u32 fixedIV = 31;
u32 otid = GetMonData(boxMon, MON_DATA_OT_ID);

// 強制 6V
for (i = 0; i < 6; i++) 
    SetBoxMonData(boxMon, MON_DATA_HP_IV + i, &fixedIV);

// 強制異色 (PID 運算公式)
u32 shinyPID = (((otid >> 16) ^ (otid & 0xFFFF) ^ 0x0000) << 16) | (Random() & 0xFFFF);
SetBoxMonData(boxMon, MON_DATA_PERSONALITY, &shinyPID);
}
